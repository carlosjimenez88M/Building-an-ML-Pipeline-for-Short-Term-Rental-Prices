#=====================#
# ---- Libraries ---- #
#=====================#
import argparse
import logging
import wandb
import pandas as pd

logging.basicConfig(level=logging.INFO, 
                    format="%(asctime)-15s %(message)s")
logger = logging.getLogger()

#=========================#
# ---- Main Function ---- #
#=========================#

def go(args):

    run = wandb.init(job_type="{{cookiecutter.job_type}}")
    run.config.update(args)

    # Download input artifact. This will also log that this script is using this
    # particular version of the artifact
    logger.info(f"Downloading input artifact: {args.input_artifact}")
    artifact_local_path = run.use_artifact(args.input_artifact).file()

    # Load data into a DataFrame
    logger.info("Loading data...")
    df = pd.read_csv(artifact_local_path)

    # Filter outliers based on price
    logger.info(f"Filtering outliers: prices between {args.min_price} and {args.max_price}")
    idx = df['price'].between(args.min_price, args.max_price)
    df = df[idx].copy()

    # Convert last_review to datetime
    logger.info("Converting last_review to datetime format")
    df['last_review'] = pd.to_datetime(df['last_review'])

    # Geolocation filter (remove points outside NYC)
    logger.info("Removing points outside NYC geolocation")
    idx = df['longitude'].between(-74.25, -73.50) & df['latitude'].between(40.5, 41.2)
    df = df[idx].copy()

    # Save cleaned DataFrame
    output_file = "clean_sample.csv"
    logger.info(f"Saving cleaned file to {output_file}")
    df.to_csv(output_file, index=False)

    # Upload cleaned artifact to W&B
    logger.info(f"Uploading cleaned artifact to W&B: {args.output_artifact}")
    artifact = wandb.Artifact(
        args.output_artifact,
        type=args.output_type,
        description=args.output_description,
    )
    artifact.add_file(output_file)
    run.log_artifact(artifact)

    logger.info("Run completed")
    run.finish()


if __name__ == "__main__":

    parser = argparse.ArgumentParser(description="{{cookiecutter.short_description}}")

{% for arg_name in cookiecutter.parameters.split(",") %}
    parser.add_argument(
        "--{{arg_name}}", 
        type={{"str" if "artifact" in arg_name or "description" in arg_name or "type" in arg_name else "float"}},
        help="{{ 'Name of the artifact in W&B' if 'artifact' in arg_name else ('Description of the artifact' if 'description' in arg_name else 'Numerical value for filtering') }}",
        required=True
    )
{% endfor %}

    args = parser.parse_args()

    go(args)
